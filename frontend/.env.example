# AeroVision Frontend Environment Configuration

# OpenAI API Key (for AeroAI Copilot live LLM completions)
VITE_OPENAI_API_KEY=

# Google Gemini API Key (optional alternative)
VITE_GEMINI_API_KEY=

# OpenWeatherMap / NOAA Aviation Weather Key (optional)
VITE_WEATHER_API_KEY=

# Backend API URL (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
