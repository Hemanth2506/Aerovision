# AeroVision Frontend Environment Configuration

# Deployed Render Backend URL (or http://localhost:8000 for local development)
VITE_API_URL=https://your-render-backend.onrender.com

# OpenAI API Key (optional direct browser connection for AeroAI Copilot)
VITE_OPENAI_API_KEY=

# Google Gemini API Key (optional alternative)
VITE_GEMINI_API_KEY=

# OpenWeatherMap / NOAA Aviation Weather Key (optional)
VITE_WEATHER_API_KEY=
